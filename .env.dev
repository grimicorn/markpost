#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_DEV="02c3b3ff35e6d620dc185e3c56cc1b380ca480c77a8d725e6ac6f8997e60be3ff8"

# .env.dev
# Netlify deploy-preview / branch-deploy build. Decrypted at build time by
# DOTENV_PRIVATE_KEY_DEV. Sits UNUSED until you enable Netlify previews: fill the
# DB below with a NON-prod Neon branch and set DOTENV_PRIVATE_KEY_DEV in Netlify.
# DB left empty on purpose so a preview can never build against production data.
DATABASE_URL=encrypted:

NUXT_DATABASE_URL=encrypted:


# Neon DB — https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
NUXT_DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Clerk — https://dashboard.clerk.com → API Keys
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
NUXT_CLERK_SECRET_KEY=sk_test_...

# Disable new user sign-ups (optional). When "true", existing users keep working
# but a newly-authenticated Clerk identity is rejected with a 403 instead of being
# registered. Read via runtimeConfig, so it bakes into the build — set it only in
# the environment you want it in. Leave empty to allow sign-ups (the local default).
NUXT_DISABLE_SIGNUPS=

# Stripe webhook signing secret — https://dashboard.stripe.com → Developers → Webhooks → your endpoint → Signing secret
# Used only for Stripe sources; an empty value causes all Stripe webhook requests to fail with 401.
STRIPE_WEBHOOK_SECRET=whsec_...

# Sentry — https://sentry.io → Settings → Projects → Client Keys (DSN)
NUXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=danholloran
SENTRY_PROJECT=markpost

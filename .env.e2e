#/-------------------[DOTENV_PUBLIC_KEY]--------------------/
#/            public-key encryption for .env files          /
#/       [how it works](https://dotenvx.com/encryption)     /
#/----------------------------------------------------------/
DOTENV_PUBLIC_KEY_E2E="026d78f6b65037007b4fcf12200c54525b7d82774d1c57f34034f3acd6044a47e5"

# .env.e2e
# Neon branch for e2e tests. In CI this is overridden by a fresh per-run branch
# URL (GitHub Actions injects E2E_DATABASE_URL), so only local runs use this value.
E2E_DATABASE_URL=encrypted:

# Clerk test-instance keys. Kept here so .env.e2e is self-contained and CI needs
# only DOTENV_PRIVATE_KEY_E2E. Mapped to CLERK_* in playwright.config.ts (used by
# @clerk/testing) and read by the Clerk Backend API that provisions the e2e test
# user in e2e/helpers/clerk.ts.
